# dados (sempre regeneraveis a partir do Portal da Transparencia)
data/
!data/.gitkeep

# artefatos de modelo (grandes; regenerar com `make ml`)
models/
!models/.gitkeep

# ambiente
.venv/
.venv-airflow/
.env
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# airflow local
airflow/logs/
airflow/plugins/
airflow/.env

# temporarios
.tmp/
*.part

# notas reais e relatórios do produto: NUNCA vão para o git
entrada-local/
saida-local/

# notas de exemplo dos 8 comércios: vai só o .zip (a pasta aberta é regenerada por `rxf exemplos-lojas`)
exemplos/lojas/notas-exemplo-raio-x/
